#-----------------------------------------------------------------------------
# Trip Sathi — Environment Configuration
# Copy to .env :  cp .env.example .env
# Generate key :  php artisan key:generate
#-----------------------------------------------------------------------------

APP_NAME="Trip Sathi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

#-----------------------------------------------------------------------------
# Logging
#-----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#-----------------------------------------------------------------------------
# Database — MySQL 8+
#-----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tripsathi
DB_USERNAME=magecomp
DB_PASSWORD=Magecomp@2014

#-----------------------------------------------------------------------------
# Session / Cache / Queue
#   Queue + Cache default to the `database` driver so the app runs with zero
#   extra infrastructure. Switch CACHE_STORE=redis / QUEUE_CONNECTION=redis in
#   production for horizontal scaling.
#-----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=tripsathi

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#-----------------------------------------------------------------------------
# Mail — local development uses `log`.
#   Mailpit: MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025
#   Gmail   : MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
#             MAIL_USERNAME=..., MAIL_PASSWORD=<app-password>, MAIL_ENCRYPTION=tls
#-----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@tripsathi.test"
MAIL_FROM_NAME="${APP_NAME}"

#-----------------------------------------------------------------------------
# Payments — never hardcode keys in code, always read from here.
#   payment.gateway = razorpay | stripe | offline
#   offline is useful for local development: booking confirmation happens via
#   an authenticated admin action instead of a gateway callback.
#-----------------------------------------------------------------------------
PAYMENT_GATEWAY=offline

RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

#-----------------------------------------------------------------------------
# Trip Sathi specific
#-----------------------------------------------------------------------------
TRIPSATHI_CURRENCY=INR
TRIPSATHI_CURRENCY_SYMBOL="&#8377;"
TRIPSATHI_TAX_PERCENT=5
TRIPSATHI_BOOKING_PREFIX=TS

# Default seeded administrator (used only by DatabaseSeeder / docs).
ADMIN_EMAIL=admin@tripsathi.test
ADMIN_PASSWORD=ChangeMe@12345

# Demo customer account created by the seeder.
DEMO_USER_EMAIL=traveller@tripsathi.test
DEMO_USER_PASSWORD=Traveler@123

# Force the seeded admin to reset their password on first login.
ADMIN_FORCE_PASSWORD_CHANGE=true

# Comma separated list of CIDRs allowed to reach /admin (blank = any).
ADMIN_ALLOWED_IPS=

# Two-factor authentication for administrators.
ADMIN_2FA_ENABLED=true

VITE_APP_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
