#=============================================================================
# Trip Sathi — Production Environment Variables for Vercel Serverless
#=============================================================================
# Copy these values into your Vercel Project Settings:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# Or add via Vercel CLI: vercel env add <KEY> production
#=============================================================================

# Application Information
APP_NAME="Trip Sathi"
APP_ENV=production
APP_KEY=base64:6zgh+ltfXgaENXPPuuaP3WjCJrdUYRHkAP/DCk7CcVs=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://trip-sathi-orpin.vercel.app

# External Cloud MySQL Database (e.g. Aiven, Railway, AWS RDS, PlanetScale, Supabase)
DB_CONNECTION=mysql
DB_HOST=your-cloud-db-host
DB_PORT=3306
DB_DATABASE=tripsathi
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
MYSQL_ATTR_SSL_CA=

# Stateless Serverless Session & Cache (Required for AWS Lambda / Vercel Functions)
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=stderr

# Payment Gateways (Razorpay & Stripe)
PAYMENT_GATEWAY=offline
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Trip Sathi Business Defaults
TRIPSATHI_CURRENCY=INR
TRIPSATHI_CURRENCY_SYMBOL="₹"
TRIPSATHI_TAX_PERCENT=5
TRIPSATHI_BOOKING_PREFIX=TS
