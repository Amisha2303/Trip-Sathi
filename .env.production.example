#-----------------------------------------------------------------------------
# Trip Sathi — Production Environment Variables for Vercel
# Add these in your Vercel Dashboard: Settings -> Environment Variables
#-----------------------------------------------------------------------------

APP_NAME="Trip Sathi"
APP_ENV=production
APP_KEY=base64:6zgh+ltfXgaENXPPuuaP3WjCJrdUYRHkAP/DCk7CcVs=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://trip-sathi-orpin.vercel.app

#-----------------------------------------------------------------------------
# Database Configuration (External Cloud MySQL - e.g. Aiven, Railway, AWS RDS, PlanetScale)
#-----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=your-cloud-db-host
DB_PORT=3306
DB_DATABASE=tripsathi
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

#-----------------------------------------------------------------------------
# Session & Cache (Stateless configuration for Serverless Lambdas)
#-----------------------------------------------------------------------------
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=log

#-----------------------------------------------------------------------------
# Payments & Keys (Configure when enabling live gateways)
#-----------------------------------------------------------------------------
PAYMENT_GATEWAY=offline
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

#-----------------------------------------------------------------------------
# Trip Sathi Business Settings
#-----------------------------------------------------------------------------
TRIPSATHI_CURRENCY=INR
TRIPSATHI_CURRENCY_SYMBOL="&#8377;"
TRIPSATHI_TAX_PERCENT=5
TRIPSATHI_BOOKING_PREFIX=TS
